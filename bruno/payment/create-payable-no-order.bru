meta {
  name: 创建应付账款—订单不存在 (400)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/payments
  body: json
  auth: inherit
}

body:json {
  {
    "orderId": 99999,
    "supplierId": 1,
    "amount": 5000
  }
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

script:pre-request {
  if (!bru.getEnvVar("token")) {
    const res = await bru.request({
      method: "POST",
      url: bru.getEnvVar("baseUrl") + "/api/v1/auth/login",
      body: JSON.stringify({"username": "admin", "password": "pass123"}),
      headers: {"Content-Type": "application/json"}
    });
    bru.setEnvVar("token", res.data.data.token);
  }
}

script:post-response {
  bru.test("Status is 400", () => {
    expect(res.status).to.equal(400);
  });
}
