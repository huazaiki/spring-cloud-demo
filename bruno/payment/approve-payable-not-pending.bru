meta {
  name: 审批付款—非 PENDING 状态 (400)
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/payments/{{payableId}}/approve
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

script:pre-request {
  if (!bru.getEnvVar("token")) {
    const res = await bru.request({
      method: "POST",
      url: bru.getEnvVar("baseUrl") + "/api/v1/auth/login",
      body: JSON.stringify({"username": "admin", "password": "pass123"}),
      headers: {"Content-Type": "application/json"}
    });
    bru.setEnvVar("token", res.data.data.token);
  }
}

script:post-response {
  bru.test("Status is 400", () => {
    expect(res.status).to.equal(400);
  });
}
