meta {
  name: 创建供应商
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/suppliers
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Acme Corp",
    "creditCode": "91110000MA001",
    "contactName": "John Doe",
    "contactPhone": "13800001111"
  }
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

script:pre-request {
  if (!bru.getEnvVar("token")) {
    const res = await bru.request({
      method: "POST",
      url: bru.getEnvVar("baseUrl") + "/api/v1/auth/login",
      body: JSON.stringify({
        "username": "admin",
        "password": "pass123"
      }),
      headers: {
        "Content-Type": "application/json"
      }
    });
    bru.setEnvVar("token", res.data.data.token);
  }
}

script:post-response {
  bru.test("Status is 200", () => {
    expect(res.status).to.equal(200);
  });

  bru.test("Response contains supplier id", () => {
    expect(res.data.data.id).to.not.be.undefined;
  });
}
