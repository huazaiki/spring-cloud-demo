meta {
  name: 获取供应商详情—不存在 (404)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/suppliers/99999
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

script:pre-request {
  if (!bru.getEnvVar("token")) {
    const res = await bru.request({
      method: "POST",
      url: bru.getEnvVar("baseUrl") + "/api/v1/auth/login",
      body: JSON.stringify({
        "username": "admin",
        "password": "pass123"
      }),
      headers: {
        "Content-Type": "application/json"
      }
    });
    bru.setEnvVar("token", res.data.data.token);
  }
}

script:post-response {
  bru.test("Status is 404", () => {
    expect(res.status).to.equal(404);
  });
}
