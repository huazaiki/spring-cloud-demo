meta {
  name: 修改供应商状态—无效状态 (400)
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/api/v1/suppliers/{{supplierId}}/status
  body: json
  auth: inherit
}

body:json {
  {
    "status": "UNKNOWN"
  }
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

script:pre-request {
  if (!bru.getEnvVar("token")) {
    const res = await bru.request({
      method: "POST",
      url: bru.getEnvVar("baseUrl") + "/api/v1/auth/login",
      body: JSON.stringify({
        "username": "admin",
        "password": "pass123"
      }),
      headers: {
        "Content-Type": "application/json"
      }
    });
    bru.setEnvVar("token", res.data.data.token);
  }
}

script:post-response {
  bru.test("Status is 400", () => {
    expect(res.status).to.equal(400);
  });
}
