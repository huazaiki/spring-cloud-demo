meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "admin",
    "password": "pass123"
  }
}

script:post-response {
  const body = JSON.parse(res.body);
  if (body.code === 200) {
    bru.setVar("token", body.data.token);
  }
}
