meta {
  name: Create Order
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "supplierId": 1,
    "items": [
      {"itemId": 1, "itemName": "Steel Rod", "quantity": 100, "unitPrice": 50, "amount": 5000}
    ]
  }
}
