meta {
  name: 库存预留
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/inventory/reserve
  body: json
  auth: inherit
}

body:json {
  {
    "itemId": {{itemId}},
    "quantity": 10
  }
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

script:pre-request {
  if (!bru.getEnvVar("token")) {
    const res = await bru.request({
      method: "POST",
      url: bru.getEnvVar("baseUrl") + "/api/v1/auth/login",
      body: JSON.stringify({"username": "admin", "password": "pass123"}),
      headers: {"Content-Type": "application/json"}
    });
    bru.setEnvVar("token", res.data.data.token);
  }
}

script:post-response {
  bru.test("Status is 200", () => {
    expect(res.status).to.equal(200);
  });
}
