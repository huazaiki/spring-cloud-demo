meta {
  name: 用户登录—密码错误 (401)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "admin",
    "password": "wrongpass"
  }
}

headers {
  Content-Type: application/json
}

script:post-response {
  bru.test("Status is 401", () => {
    expect(res.status).to.equal(401);
  });
}
